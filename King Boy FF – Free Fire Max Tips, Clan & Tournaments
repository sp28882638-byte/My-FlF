<section id="join"><div class="wrap">
<h2>Apply to join</h2>
<p class="sub">Fill this in, then send the copied message to us on [your contact].</p>
<form id="f">
<label>In-game name<input name="n" required></label>
<label>UID<input name="u" inputmode="numeric" required></label>
<label>Level<input name="l" inputmode="numeric" required></label>
<label>Rank<select name="r"><option>Bronze</option><option>Silver</option><option>Gold</option><option>Platinum</option><option>Diamond</option><option>Heroic</option><option>Grandmaster</option></select></label>
<label>Region<input name="g" required></label>
<label>Preferred play time<input name="t" required></label>
<button class="btn main" type="submit">Copy my application</button>
<div class="msg" id="m" role="status"></div>
</form></div></section>

<footer>&#169; King Boy FF. Not affiliated with Garena.</footer>

<script>
document.getElementById('f').addEventListener('submit',function(e){
e.preventDefault();
var d=new FormData(this),m=document.getElementById('m');
var t='King Boy FF clan application\nName: '+d.get('n')+'\nUID: '+d.get('u')+'\nLevel: '+d.get('l')+'\nRank: '+d.get('r')+'\nRegion: '+d.get('g')+'\nPlay time: '+d.get('t');
try{navigator.clipboard.writeText(t).then(function(){m.textContent='Copied. Send it to us now.'},function(){m.textContent='Copy failed. Select and copy this: '+t.replace(/\n/g,' | ')})}
catch(x){m.textContent='Copy failed. Select and copy this: '+t.replace(/\n/g,' | ')}
});
</script>
